<Window x:Class="YSAudioPlayerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YSAudioPlayerApp"
        mc:Ignorable="d"
        Title="YS Audio Player" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open folder" Click="OpenFolderMenuItem_Click" ToolTip="Open folder with audio files"/>
                <MenuItem Header="_Exit" Click="ExitMenuItem_Click" ToolTip="Close player"/>
            </MenuItem>
            <!--
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
            </MenuItem>
            -->
        </Menu>
        <ListView x:Name="ListView_Tracks" Margin="5">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="200"/>
                    <GridViewColumn Header="File" DisplayMemberBinding="{Binding FileName}" Width="100"/>
                    <GridViewColumn Header="Duration" DisplayMemberBinding="{Binding DurationToString}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
